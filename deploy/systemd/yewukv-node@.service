[Unit]
Description=yewukv Raft node %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=yewukv
Group=yewukv
EnvironmentFile=/etc/yewukv/node-%i.env
ExecStart=/usr/local/bin/yewukv-node --id %i --listen-host ${YEWUKV_LISTEN_HOST} --port ${YEWUKV_PORT} --members ${YEWUKV_MEMBERS} --data-dir /var/lib/yewukv/node-%i
StateDirectory=yewukv/node-%i
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
